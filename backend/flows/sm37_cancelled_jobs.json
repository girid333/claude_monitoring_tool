{
  "flow_id": "sm37_cancelled_jobs",
  "description": "Check for cancelled background jobs since yesterday (Phase 1 reference flow; ALV-heavy on purpose)",
  "applies_to": ["ECC6_*", "S4_*"],
  "params": { "from_date": "{{today-1}}", "user": "*" },
  "schema_version": 1,
  "steps": [
    { "act": "start_tcode", "value": "SM37" },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/txtBTCH2170-JOBNAME",
                  "dom": { "attr": {"title": "Job Name"}, "label": "Job name" } },
      "value": "*" },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/txtBTCH2170-USERNAME",
                  "dom": { "attr": {"title": "User Name"}, "label": "User name" } },
      "value": "{{user}}" },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/ctxtBTCH2170-FROM_DATE",
                  "dom": { "label": "From date" } },
      "value": "{{from_date}}" },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-PRELIM", "dom": { "label": "Sched." } },
      "value": false },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-SCHEDUL", "dom": { "label": "Released" } },
      "value": false },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-READY", "dom": { "label": "Ready" } },
      "value": false },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-RUNNING", "dom": { "label": "Active" } },
      "value": false },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-FINISHED", "dom": { "label": "Finished" } },
      "value": false },
    { "act": "set",
      "target": { "sid": "wnd[0]/usr/chkBTCH2170-ABORTED", "dom": { "label": "Canceled" } },
      "value": true },
    { "act": "vkey", "value": 8, "note": "F8 execute" },
    { "act": "wait_ready" },
    { "act": "capture",
      "mode": ["screenshot", "table", "statusbar"],
      "target": { "sid": "wnd[0]/usr/cntlGRID1/shellcont/shell",
                  "dom": { "css_hint": "urST5" } } },
    { "act": "check", "type": "row_count", "op": "==", "value": 0,
      "severity": "high",
      "message": "Cancelled background jobs found since yesterday" }
  ]
}
